<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function ratna_bs5_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
 * Implements hook_library_info_alter().
 *
 * Drupal 11 = jQuery 4 (sans $.isFunction/$.isArray/$.trim/$.type). colorbox
 * et superfish les utilisent encore → on force le polyfill ratna_bs5/jquery_compat
 * à se charger avant eux. (Porté de ratna.)
 */
function ratna_bs5_library_info_alter(array &$libraries, $extension) {
  if ($extension === 'colorbox' && isset($libraries['colorbox'])) {
    $libraries['colorbox']['dependencies'][] = 'ratna_bs5/jquery_compat';
  }
}
