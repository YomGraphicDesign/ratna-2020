# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/htdocs/core/
/htdocs/modules/contrib/
/htdocs/themes/contrib/
!/htdocs/themes/contrib/ratna/
!/htdocs/themes/contrib/base/
/htdocs/profiles/
/htdocs/libraries/

# Ignore sensitive information
/htdocs/sites/*/settings.php
/htdocs/sites/*/settings.local.php

# Ignore Drupal's file directory
/htdocs/sites/*/files/

# Ignore SimpleTest multi-site environment.
/htdocs/sites/simpletest

# Éditeurs / OS
/.idea/
.DS_Store
._*
Thumbs.db
.nova/
.claude/

# Variables d'environnement
/.env

# Legacy / non versionné
/old 2020/
/console/

# Artefacts de compilation SASS
.sass-cache/
*.css.map

# Backups locaux (non versionnés)
/Backup/
/archives/
/archives.zip
/archives_bdd/
/tmp/
*.sql.gz
*.tar.gz
