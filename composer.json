{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "enyo/dropzone",
                "version": "5.5.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/enyo/dropzone",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "desandro/masonry",
                "version": "4.2.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/desandro/masonry",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "desandro/imagesloaded",
                "version": "4.1.4",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/desandro/imagesloaded",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "frdh/mmenu",
                "version": "8.5.24",
                "type": "drupal-library",
                "dist": {
                    "url": "https://registry.npmjs.org/mmenu-js/-/mmenu-js-8.5.24.tgz",
                    "type": "tar"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "desandro/imagesloaded": "^4.0",
        "desandro/masonry": "^4.0",
        "drupal/admin_toolbar": "^3.0",
        "drupal/adminimal_admin_toolbar": "^2.0",
        "drupal/adminimal_theme": "^1.7",
        "drupal/autoban": "^1.13",
        "drupal/autologout": "^2.0",
        "drupal/backup_migrate": "^5.0",
        "drupal/bartik": "^1.1",
        "drupal/blazy": "^2.17",
        "drupal/bootstrap": "^3.40",
        "drupal/ckeditor": "^1.0",
        "drupal/color": "^1.0",
        "drupal/colorbox": "^2.0",
        "drupal/colorbox_inline": "^2.0",
        "drupal/colorbox_load": "^2.0",
        "drupal/core": "^10",
        "drupal/core-composer-scaffold": "^10",
        "drupal/crop": "^2.0",
        "drupal/devel": "^5.0",
        "drupal/draggableviews": "^2.0",
        "drupal/dropzonejs": "^2.0",
        "drupal/embed": "^1.0",
        "drupal/entity": "^1.0",
        "drupal/entity_browser": "^2.9",
        "drupal/entity_embed": "^1.0",
        "drupal/entity_reference_revisions": "^1.0",
        "drupal/features": "^3.12",
        "drupal/field_group": "^3.4",
        "drupal/google_analytics": "^4.0",
        "drupal/google_analytics_reports": "^4.0",
        "drupal/honeypot": "^2.1",
        "drupal/image_effects": "^3.0",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^1.0",
        "drupal/install_profile_generator": "^4.0",
        "drupal/libraries": "^4.0",
        "drupal/menu_block": "^1.0",
        "drupal/metatag": "^2.0",
        "drupal/module_filter": "^4.0",
        "drupal/pathauto": "^1.8",
        "drupal/profile": "^1.0",
        "drupal/quick_node_clone": "^1.14",
        "drupal/rdf": "^2.1",
        "drupal/redirect": "^1.6",
        "drupal/rename_admin_paths": "^3.0",
        "drupal/responsive_menu": "^4.0",
        "drupal/select_or_other": "^4.0",
        "drupal/seven": "^1.0",
        "drupal/simple_sitemap": "^4.0",
        "drupal/slick": "^2.10",
        "drupal/slick_views": "^2.2",
        "drupal/superfish": "^1.4",
        "drupal/taxonomy_menu": "^3.5",
        "drupal/token": "^1.9",
        "drupal/upgrade_status": "^4.0",
        "drupal/views_bootstrap": "^5.0",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/webform": "^6.2",
        "drush/drush": "^12 || ^13",
        "enyo/dropzone": "^5.0",
        "frdh/mmenu": "^8.0",
        "vlucas/phpdotenv": "^4.0",
        "webflo/drupal-finder": "^1.0.0",
        "zaporylie/composer-drupal-optimizations": "^1.2"
    },
    "require-dev": {
        "drupal/core-dev": "^10"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "zaporylie/composer-drupal-optimizations": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/taxonomy_menu": {
                "Respect configured menu_parent for top-level terms": "patches/taxonomy_menu/respect-configured-menu-parent.patch"
            }
        },
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "htdocs/"
            }
        },
        "installer-paths": {
            "htdocs/core": ["type:drupal-core"],
            "htdocs/libraries/{$name}": ["type:drupal-library"],
            "htdocs/modules/contrib/{$name}": ["type:drupal-module"],
            "htdocs/profiles/contrib/{$name}": ["type:drupal-profile"],
            "htdocs/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        }
    }
}
