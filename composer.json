{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "enyo/dropzone",
                "version": "5.5.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/enyo/dropzone",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "desandro/masonry",
                "version": "4.2.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/desandro/masonry",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "desandro/imagesloaded",
                "version": "4.1.4",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/desandro/imagesloaded",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        }
    ],
    "require": {
        "php": ">=7.0.8",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.5",
        "desandro/imagesloaded": "^4.0",
        "desandro/masonry": "^4.0",
        "drupal/admin_toolbar": "^2.0",
        "drupal/adminimal_admin_toolbar": "^1.0",
        "drupal/adminimal_theme": "^1.5",
        "drupal/autoban": "^1.9",
        "drupal/autologout": "^1.0",
        "drupal/backup_migrate": "^4.0",
        "drupal/blazy": "^2.0",
        "drupal/bootstrap": "^3.21",
        "drupal/colorbox": "^1.4",
        "drupal/colorbox_inline": "^1.1",
        "drupal/colorbox_load": "^1.0",
        "drupal/console": "^1.0.2",
        "drupal/console-fr": "^1.0@RC",
        "drupal/contribute": "^1.0",
        "drupal/core": "^8.8.0",
        "drupal/core-composer-scaffold": "^8.8.0",
        "drupal/crop": "^2.0",
        "drupal/devel": "^2.0",
        "drupal/draggableviews": "^1.0",
        "drupal/dropzonejs": "^2.0",
        "drupal/embed": "^1.0",
        "drupal/entity": "^1.0",
        "drupal/entity_embed": "1.x-dev",
        "drupal/entity_reference_revisions": "^1.0",
        "drupal/features": "^3.0",
        "drupal/field_group": "3.x-dev",
        "drupal/google_analytics": "^2.0",
        "drupal/google_analytics_reports": "^3.0",
        "drupal/image_effects": "^2.0",
        "drupal/image_widget_crop": "^2.2",
        "drupal/inline_entity_form": "^1.0",
        "drupal/install_profile_generator": "^2.0",
        "drupal/libraries": "^3.0",
        "drupal/media_entity": "^1.0",
        "drupal/media_entity_browser": "^2.0",
        "drupal/menu_block": "^1.0",
        "drupal/metatag": "^1.0",
        "drupal/module_filter": "^3.0",
        "drupal/pathauto": "^1.0",
        "drupal/profile": "^1.0",
        "drupal/quick_node_clone": "^1.12",
        "drupal/redirect": "^1.0",
        "drupal/rename_admin_paths": "^2.0",
        "drupal/responsive_menu": "^2.0",
        "drupal/select_or_other": "^1.0",
        "drupal/simple_sitemap": "^3.0",
        "drupal/slick": "^2.1",
        "drupal/slick_views": "^2.2",
        "drupal/superfish": "^1.3",
        "drupal/swiftmailer": "^1.0",
        "drupal/taxonomy_menu": "^3.0",
        "drupal/token": "^1.0",
        "drupal/views_bootstrap": "^3.1",
        "drupal/views_bulk_operations": "^3.6",
        "drupal/webform": "^5.0",
        "drush/drush": "^9.7.1 | ^10.0.0",
        "enyo/dropzone": "^4.0",
        "vlucas/phpdotenv": "^4.0",
        "webflo/drupal-finder": "^1.0.0",
        "zaporylie/composer-drupal-optimizations": "^1.0"
    },
    "require-dev": {
        "drupal/core-dev": "^8.8.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "htdocs/"
            }
        },
        "installer-paths": {
            "htdocs/core": ["type:drupal-core"],
            "htdocs/libraries/{$name}": ["type:drupal-library"],
            "htdocs/modules/contrib/{$name}": ["type:drupal-module"],
            "htdocs/profiles/contrib/{$name}": ["type:drupal-profile"],
            "htdocs/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        }
    }
}
